{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/index.ts",
    "src/contracts/**/*",
    "src/crypto/**/*",
    "src/cloud/**/*",
    "src/operations/deleteEntryOperation.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/__tests__/**/*",
    "src/ui/**/*"
  ]
}
