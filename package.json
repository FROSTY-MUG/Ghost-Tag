{
  "name": "@frosty-mug/ghost-tag",
  "version": "2.0.6",
  "description": "Hardware-anchored encrypted NFC distributed file-vault & binary envelope protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FROSTY-MUG/Ghost-Tag.git"
  },
  "homepage": "https://frosty-mug.github.io/Ghost-Tag/",
  "bugs": {
    "url": "https://github.com/FROSTY-MUG/Ghost-Tag/issues"
  },
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/patch_dependencies.js",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && jest",
    "audit:security": "python scripts/security_audit_agent.py",
    "audit:quality": "python scripts/quality_audit_agent.py",
    "audit": "python scripts/security_audit_agent.py && python scripts/quality_audit_agent.py",
    "build:apk": "python scripts/package_release_apk.py",
    "web": "npx --yes serve web -l 8080"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.88.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "buffer": "^6.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-argon2": "^4.0.0",
    "react-native-keychain": "^11.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-nfc-manager": "^4.2.0",
    "react-native-quick-crypto": "^1.1.9",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.9"
    },
    "deepmerge": "^4.3.1"
  }
}
